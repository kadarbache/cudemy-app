model Review {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  rating Int
  body   String? @db.String

  // the instructor's answer to this review. it carries no rating of its own, so
  // it never reaches the groupBy behind the course average (see ADR 0001)
  reply     String?   @db.String
  repliedAt DateTime?

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // one verdict per person per course, same rule as the cart and the wishlist
  @@unique([userId, courseId])
  @@map("reviews")
}
